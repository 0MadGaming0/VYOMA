# ── PostgreSQL Database (Astronaut profiles, vitals, alerts) ─────────────────
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vyoma_db

# ── MongoDB (Astronaut authentication credentials & sessions) ────────────────
MONGO_URL=mongodb://localhost:27017
MONGO_DB=vyoma_auth

# ── JWT Authentication ───────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-random-256-bit-hex-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Administrator Provisioning Key ───────────────────────────────────────────
# Header: X-Admin-Key: <ADMIN_KEY> for POST /api/auth/provision
# Generate with: python3 -c "import secrets; print(secrets.token_hex(24))"
ADMIN_KEY=your-admin-provisioning-key-here

# ── Cookie Security ──────────────────────────────────────────────────────────
# Set to true in production behind HTTPS
SECURE_COOKIES=false
