# ── PostgreSQL Database (Astronaut profiles, vitals, alerts) ─────────────────
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vyoma_db

# ── MongoDB (Astronaut authentication credentials & sessions) ────────────────
MONGO_URL=mongodb://localhost:27017
MONGO_DB=vyoma_auth

# ── JWT Authentication ───────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-random-256-bit-hex-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Administrator Provisioning Key ───────────────────────────────────────────
# Header: X-Admin-Key: <ADMIN_KEY> for POST /api/auth/provision
# Generate with: python3 -c "import secrets; print(secrets.token_hex(24))"
ADMIN_KEY=your-admin-provisioning-key-here

# ── Cookie Security ──────────────────────────────────────────────────────────
# Set to true in production behind HTTPS
SECURE_COOKIES=false

# ── CORS Allowed Origins (Production) ─────────────────────────────────────────
# Comma-separated list of additional allowed frontend origins (e.g. Render, Vercel).
# Do not use wildcard (*) because credentials/cookies are enabled.
# CORS_ORIGINS=https://vyoma.onrender.com,https://vyoma.vercel.app

# ── AstroAssist AI Chatbot (Optional Frontier LLM) ───────────────────────────
# If unset, AstroAssist runs using its built-in NASA STD-3001 clinical engine.
# Set ONE of the following to connect to an external LLM:
#
# Option A: Groq (Ultra-fast, Llama 3.3 70B / 3.1 8B)
# GROQ_API_KEY=gsk_...
#
# Option B: OpenAI
# OPENAI_API_KEY=sk-...
#
# Option C: Google Gemini
# GEMINI_API_KEY=AIzaSy...
#
# Option D: Neon AI Gateway
# NEON_AI_GATEWAY_KEY=...
# NEON_AI_GATEWAY_URL=https://ai.neon.tech/v1
#
# Optional custom model name (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant, gpt-4o-mini):
# AI_MODEL=llama-3.3-70b-versatile
